<?php

declare(strict_types=1);

namespace App\Http\Controllers;

use Cg\Cms\Cache\CacheContext;
use Cg\Cms\Cache\CollectionVersion;
use Cg\Cms\Models\Entry;
use Illuminate\Contracts\View\View;
use Illuminate\Support\Facades\Cache;
use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;

/**
 * [[routeBase]]: [[label]]. Generated by cms:collection.
 *
 * Both pages register what they read with the cache context, so publishing
 * an entry purges exactly the pages that show it.
 */
final class [[class]] extends Controller
{
    public function __construct(
        private readonly CacheContext $cacheContext,
        private readonly CollectionVersion $versions,
    ) {}

    public function index(): View
    {
        $this->cacheContext->registerCollection('[[handle]]');

        $entries = Cache::remember(
            $this->versions->key('[[handle]]', 'index'),
            now()->addHours(6),
            fn (): array => Entry::query()
                ->collection('[[handle]]')
                ->published()
                ->orderByDesc('published_at')
                ->orderBy('id')
                ->limit(100)
                ->get()
                ->map(fn (Entry $entry): array => [
                    'title' => $entry->title,
                    'url' => $entry->url(),
                    'summary' => '[[summary]]' === '' ? '' : (string) $entry->value('[[summary]]', ''),
                ])
                ->all(),
        );

        return view('[[view]].index', ['entries' => $entries]);
    }

    public function show(string $slug): View
    {
        $entry = Entry::query()
            ->collection('[[handle]]')
            ->published()
            ->where('slug', $slug)
            ->first() ?? throw new NotFoundHttpException;

        $this->cacheContext->registerEntry($entry);
[[registerRelations]]
        return view('[[view]].show', [
            'entry' => $entry,
            'related' => [
[[relations]]
            ],
        ]);
    }
}
