{{-- [[routeBase]], generated by cms:collection. --}}
@extends('layouts.app')

@section('head')
    <x-cms-seo title="[[label]]" />
@endsection

@section('content')
    <h1>[[label]]</h1>

    @forelse ($entries as $item)
        <article>
            <h2><a href="{{ $item['url'] }}">{{ $item['title'] }}</a></h2>
            @if ($item['summary'] !== '')
                <p>{{ $item['summary'] }}</p>
            @endif
        </article>
    @empty
        <p>Nothing here yet.</p>
    @endforelse
@endsection
