<?php

declare(strict_types=1);

use Cg\Cms\Models\Entry;
use Illuminate\Foundation\Testing\RefreshDatabase;

uses(RefreshDatabase::class);

/*
| [[label]], generated by cms:collection.
*/

function make[[studly]]Entry(string $slug, string $title, string $status = 'published'): Entry
{
    return Entry::query()->create([
        'collection' => '[[handle]]',
        'slug' => $slug,
        'title' => $title,
        'status' => $status,
        'published_at' => now()->subDay(),
    ]);
}

it('lists published [[label]] and leaves drafts out', function (): void {
    make[[studly]]Entry('live-one', 'A live one');
    make[[studly]]Entry('draft-one', 'A draft one', 'draft');

    $this->get('[[routeBase]]')
        ->assertOk()
        ->assertSee('A live one')
        ->assertDontSee('A draft one');
});

it('renders a published entry and 404s a draft', function (): void {
    make[[studly]]Entry('live-one', 'A live one');
    make[[studly]]Entry('draft-one', 'A draft one', 'draft');

    $this->get('[[routeBase]]/live-one')->assertOk()->assertSee('A live one');
    $this->get('[[routeBase]]/draft-one')->assertNotFound();
});
