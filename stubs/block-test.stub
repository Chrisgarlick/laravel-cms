<?php

declare(strict_types=1);

use Cg\Cms\Schema\BlockRegistry;
use Illuminate\Support\Facades\View;

/*
| The [[label]] block, generated by cms:block.
*/

it('registers the [[label]] block', function (): void {
    expect(app(BlockRegistry::class)->has('[[handle]]'))->toBeTrue();
});

it('renders the [[label]] block with its values', function (): void {
    $html = View::make('cgcms::blocks.[[handle]]', [
        'block' => app(BlockRegistry::class)->get('[[handle]]'),
        'data' => [
[[sample]]
        ],
        'html' => [],
        'items' => [],
        'theme' => 'light',
    ])->render();

    expect($html)->toContain('data-block="[[handle]]"')->toContain('[[expect]]');
});
