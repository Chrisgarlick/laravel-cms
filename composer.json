{
    "name": "chrisgarlick/cg-cms",
    "description": "A lightweight, SEO-first CMS for Laravel. Content in jsonb, HTML on disk, nginx does the serving.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Chris Garlick",
            "email": "chris@chrisgarlick.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "inertiajs/inertia-laravel": "^3.3"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Cg\\Cms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cg\\Cms\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cg\\Cms\\CgCmsServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
